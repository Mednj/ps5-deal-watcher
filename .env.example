# Copy to .env and keep it private. Local evaluation needs no secrets.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8765
# Optional single-password access. Generate with scripts/password.py.
# Wrap the generated hash in single quotes to prevent Compose $ interpolation.
APP_PASSWORD_HASH=''
COOKIE_SECURE=false
# For remote HTTPS, set a real DNS name pointing to the server, set COOKIE_SECURE=true,
# open ports 80/443 and start with: docker compose --profile https up -d
WATCHER_DOMAIN=
# Optional; configure locally in Settings instead if preferred.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETAIN_COUNT=14
