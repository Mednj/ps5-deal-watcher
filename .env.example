# Copy to .env and keep it private. Local evaluation needs no secrets.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8765
# Fresh installs bootstrap admin / admin@. The temporary password is forced
# to change on first login; admin can then create private user accounts.
# For unattended remote provisioning, set a unique BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_PASSWORD=
COOKIE_SECURE=false
# For remote HTTPS, set a real DNS name pointing to the server, set COOKIE_SECURE=true,
# open ports 80/443 and start with: docker compose --profile https up -d
WATCHER_DOMAIN=
# Optional system incident alerts and admin-account Telegram fallback.
# Other users' deal alerts always use their private Settings credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETAIN_COUNT=14
